# The announcer service: a lightweight image (Bun + ffmpeg + Piper local TTS +
# local whisper.cpp STT + the Claude CLI) that tails the coach's activity log,
# speaks the draft picks into a Discord voice channel, and (when LISTENER_ENABLED
# is on) listens and fires back comebacks. No Playwright/browser stack, unlike
# the main coach image.

# #region whisper.cpp builder
# Build the whisper-cli speech-to-text binary in a throwaway stage so the build
# toolchain never ships in the final image. Static (no shared ggml libs) and
# OpenMP off, so the binary needs only the C/C++ runtimes already in the base
# image. Only used by the LISTEN + COMEBACK phase (LISTENER_ENABLED).
FROM oven/bun:1-debian AS whisper-build
ARG WHISPER_VERSION=v1.7.4
ARG WHISPER_MODEL=base.en
RUN apt-get update \
 && apt-get install -y --no-install-recommends git cmake build-essential curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${WHISPER_VERSION}" https://github.com/ggml-org/whisper.cpp /tmp/whisper.cpp \
 && cmake -S /tmp/whisper.cpp -B /tmp/whisper.cpp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=OFF \
      -DGGML_OPENMP=OFF \
      -DWHISPER_BUILD_TESTS=OFF \
      -DWHISPER_BUILD_EXAMPLES=ON \
 && cmake --build /tmp/whisper.cpp/build -j --config Release --target whisper-cli \
 && mkdir -p /opt/whisper/models \
 && cp /tmp/whisper.cpp/build/bin/whisper-cli /opt/whisper/whisper-cli \
 && curl -fsSL -o "/opt/whisper/models/ggml-${WHISPER_MODEL}.bin" \
      "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${WHISPER_MODEL}.bin?download=true"
# #endregion

FROM oven/bun:1-debian

ARG PIPER_VERSION=2023.11.14-2
ARG PIPER_VOICE=en_US-lessac-medium

# ffmpeg transcodes Piper's WAV to Opus for Discord (used by @discordjs/voice).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Piper: prebuilt binary + one English voice model. The tarball unpacks to
# /opt/piper and bundles its own shared libs and espeak-ng-data.
RUN curl -fsSL "https://github.com/rhasspy/piper/releases/download/${PIPER_VERSION}/piper_linux_x86_64.tar.gz" \
      | tar -xzf - -C /opt \
 && mkdir -p /opt/piper/voices \
 && curl -fsSL -o "/opt/piper/voices/${PIPER_VOICE}.onnx" \
      "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/${PIPER_VOICE}.onnx?download=true" \
 && curl -fsSL -o "/opt/piper/voices/${PIPER_VOICE}.onnx.json" \
      "https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/${PIPER_VOICE}.onnx.json?download=true"
ENV PIPER_BIN=/opt/piper/piper \
    PIPER_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx \
    PIPER_ESPEAK_DATA=/opt/piper/espeak-ng-data \
    PIPER_LIB_DIR=/opt/piper \
    LD_LIBRARY_PATH=/opt/piper

# whisper.cpp binary + English model from the builder stage (LISTEN phase STT).
COPY --from=whisper-build /opt/whisper /opt/whisper
ENV WHISPER_BIN=/opt/whisper/whisper-cli \
    WHISPER_MODEL=/opt/whisper/models/ggml-base.en.bin

# Claude CLI, used by the runner to compose the overlord lines. Installed at
# build into a fixed HOME so no writable data mount is needed at runtime; auth
# comes from CLAUDE_CODE_OAUTH_TOKEN in the env file.
ENV HOME=/root
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV CLAUDE_BIN=/root/.local/bin/claude
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Browsers are never used here; skip the Playwright download during install.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

CMD ["bun", "run", "src/announcer/index.ts"]
