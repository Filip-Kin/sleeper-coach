# Copy to /data/sleeper-coach/env on the NAS and fill in. Never commit the real
# file. The container reads it via docker-compose `env_file`.

# Claude auth: subscription token from `claude setup-token` (bills the plan).
CLAUDE_CODE_OAUTH_TOKEN=

# Break-glass: if set, the runner can use API billing instead (draft-day headroom).
# ANTHROPIC_API_KEY=

# noVNC / x11vnc password for the takeover view.
WEB_PASS=

# Home Assistant push (Phase F). Long-lived token + a notify service URL.
HA_NOTIFY_URL=
HA_TOKEN=

# Announcer (Discord voice bot that speaks the coach's draft picks). Create a
# Discord app + bot, enable the Guilds + GuildVoiceStates intents, and invite it
# with Connect + Speak. Leave blank to keep the announcer service dormant.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Optional overrides.
# COACH_MODEL=claude-opus-4-8
# COACH_EFFORT=high
# POLL_INTERVAL_MS=90000
# ANNOUNCER_AGENT_TIMEOUT_MS=45000
