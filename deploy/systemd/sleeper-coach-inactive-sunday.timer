[Unit]
Description=sleeper-coach: Sunday-evening inactive re-check (timer)

[Timer]
# Times are US Eastern. The host is on America/New_York, and systemd 247 (this
# host) evaluates OnCalendar in the host timezone, which keeps these correct
# across the EDT/EST switch automatically. If the host timezone ever changes,
# these shift with it - re-anchor them or upgrade to a systemd that supports a
# timezone suffix in OnCalendar (>= 251).
OnCalendar=Sun *-*-* 18:45:00
# Persistent=false ON PURPOSE for a lineup lock. A lineup is only valid BEFORE
# kickoff. The solver is blind to in-game locks and setLineup cannot move a
# player whose game has already started, so a catch-up fire after the box was
# down would land AFTER kickoff, fail its read-back verification and can leave a
# half-rearranged lineup - strictly worse than leaving the already-set lineup
# alone (Filip: a lineup set after kickoff is worse than not setting one). A
# missed lock is skipped, not replayed late; Thursday already sets a complete
# lineup that stands, and any lock can be re-run by hand before its kickoff.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
