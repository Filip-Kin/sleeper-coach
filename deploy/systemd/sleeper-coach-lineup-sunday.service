[Unit]
# THE main lock, before the 13:00 ET kickoffs. Final lineup for the week.
Description=sleeper-coach: Set the main weekly lineup (the lock)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The coach container name changes on every Coolify rebuild, so it is always
# looked up rather than hard-coded (same reason scripts/preflight.sh looks it up).
# The runner reads its league, browser API and HA alert env from the container,
# so with no override it targets the REAL league - which is correct in production.
ExecStart=/bin/bash -lc 'set -euo pipefail; C=$(docker ps --format "{{.Names}}" | grep "^sleeper-coach" | head -1); if [ -z "$C" ]; then echo "no sleeper-coach container running"; exit 1; fi; exec docker exec "$C" bash -lc "cd /app && bun run src/act/lineup-run.ts --live"'
# A lock is missed rather than dangerous if it runs late, but never let one hang.
TimeoutStartSec=600
